// iPhone and iPad app settings (ADR 0027), layered on the project Debug/Release
// config. The Mac-only values in Base.xcconfig are overridden here.

PRODUCT_NAME = LemmeType
PRODUCT_MODULE_NAME = LemmeTypeiOS
PRODUCT_BUNDLE_IDENTIFIER = com.lemmetype.LemmeType.iOS
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2
ARCHS = arm64

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = LemmeType
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 LemmeType. All rights reserved.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
// What a Release build offers (docs/release/app-store.md, "Release scope"):
//   local  Version 1.0: Local dictation only. No Cloud speech, LEMMETYPE_GATEWAY_HOST must be empty, the
//          privacy manifest declares no collected data, and the store text never mentions Cloud.
//   cloud  The Cloud release: only once every launch gate in docs/release/app-store.md section 9 is Closed.
//          Also swap in Config/PrivacyInfo-Cloud.xcprivacy and the Cloud store text.
// scripts/verify-ios-appstore.sh checks that the archive, the manifest, and the docs agree with this value.
LEMMETYPE_RELEASE_SCOPE = local

// The microphone text follows the scope, so it never names a feature the build doesn't have (E13-S8).
LEMMETYPE_MICROPHONE_TEXT_local = LemmeType records your voice only while the recording is showing on screen, and turns it into text on this device.
LEMMETYPE_MICROPHONE_TEXT_cloud = LemmeType records your voice only while the recording is showing on screen. It turns it into text on this device, unless you use a mode with Cloud speech, which you turn on yourself and which sends the recording to LemmeType's server to be turned into text.
INFOPLIST_KEY_NSMicrophoneUsageDescription = $(LEMMETYPE_MICROPHONE_TEXT_$(LEMMETYPE_RELEASE_SCOPE))
// Debug always offers Cloud speech (staging), so it always says so.
INFOPLIST_KEY_NSMicrophoneUsageDescription[config=Debug] = $(LEMMETYPE_MICROPHONE_TEXT_cloud)
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = If you choose Apple Speech, LemmeType uses on-device speech recognition to turn your dictation into text. Audio never leaves this device.
// Only standard, exempt encryption: HTTPS for the model download (and, in the cloud scope, the speech gateway).
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

// One App Group for the keyboard, and audio in the background for Action Button dictation (ADR 0032).
CODE_SIGN_ENTITLEMENTS = App/LemmeTypeiOS/LemmeTypeiOS.entitlements
INFOPLIST_FILE = App/LemmeTypeiOS/Info.plist
INFOPLIST_KEY_NSSupportsLiveActivities = YES

// The production speech gateway (ADR 0033, E13-S8): a host name only, no scheme. Empty keeps Cloud speech, and the
// Telugu choice that depends on it, off in a Release build. A Release build uses it only in the cloud scope, and
// only when every launch gate in docs/release/app-store.md is Closed; scripts/verify-ios-appstore.sh refuses a
// build otherwise.
LEMMETYPE_GATEWAY_HOST =
